<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64" role="img" aria-labelledby="title desc">
  <title id="title">Gio &amp; Britt</title>
  <desc id="desc">Monogram emblem with leaf accent</desc>

  <!-- background rounded square (soft neutral) -->
  <rect width="64" height="64" rx="10" fill="#F6EAE2"/>

  <!-- main circle (primary accent) -->
  <circle cx="32" cy="32" r="22" fill="#2B6E4A"/>

  <!-- decorative leaf accent -->
  <path d="M44 24c-3 1-6 0-8 2-2 2-1 6 1 8 2 2 6 1 8-1 2-2 2-6-1-9z" fill="#F6EAE2" opacity="0.95"/>

  <!-- monogram (uses system serif stack) -->
  <text x="32" y="38" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-weight="700" font-size="20" fill="#ffffff">GB</text>
</svg>
